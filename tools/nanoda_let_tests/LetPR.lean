-- Small `let` tests for nanoda's own test suite (test_resources/Let), generated by
-- tools/nanoda_let_pr_resources.py. Only Bool, Eq and True, so the exports stay small. In every
-- theorem, type-checking the proof needs the value of a let-bound variable: the argument `rfl`
-- has type `true = true`, and the binder type mentions the variable.
--
-- The generator builds ill-typed variants by replacing one value with `false`. It finds that let
-- by the function in its value, so `not` (`!`), `and` (`&&`) and `or` (`||`) appear only there.
-- lean4export shares equal nodes regardless of binder names, which is why the values differ.

-- first, so that the replacement values `false` and `True.intro` come earlier in the export than
-- the lets they are put into (an export may only refer to nodes defined above)
theorem let_values_first : false = false ∧ True := ⟨rfl, True.intro⟩

-- siblings with the same name and type: the second is the one changed
theorem let_siblings : True ∧ True :=
  ⟨let b : Bool := true; (fun (_ : b = true) => trivial) rfl,
   let b : Bool := !false; (fun (_ : b = true) => trivial) rfl⟩

-- shadowing with the same name and type: the inner one is changed
theorem let_shadow : True :=
  let b : Bool := true; let b : Bool := true && true; (fun (_ : b = true) => trivial) rfl

-- two declarations with lets of the same name and type: the second is changed
theorem let_decl_a : True := let b : Bool := true; (fun (_ : b = true) => trivial) rfl
theorem let_decl_b : True := let b : Bool := true || false; (fun (_ : b = true) => trivial) rfl

-- a value that nothing uses: the generator gives it a value of the wrong type (`True.intro`)
theorem let_unused : True := let u : Bool := false; trivial
